# Copy to .env.local (git-ignored) and fill in. Next.js loads it for dev/build/start,
# and `pnpm sync` loads it too. On the host, set the same names in its environment settings.

# Server-only: read-only fine-grained token (Metadata + Contents) limited to the Allowlisted repos.
GITHUB_TOKEN=

# Checked by POST /api/revalidate (send it in the `x-revalidate-key` header).
REVALIDATE_KEY=

# --- Only `pnpm sync` reads the rest; the running site never does. ---

# gemini (default) or libretranslate
TRANSLATOR=gemini
# Free key from Google AI Studio. Never commit it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# For TRANSLATOR=libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=
